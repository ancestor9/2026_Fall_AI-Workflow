    {
      "parameters": {
        "jsCode": "for (const item of $input.all()) {\n  // 공백 및 맨 끝의 마침표(.) 제거\n  let url = (item.json['github_url'] || '').trim().replace(/\\.+$/, '');\n  \n  if (url.includes('github.com') && url.includes('/blob/')) {\n    item.json.rawUrl = url\n      .replace('github.com', 'raw.githubusercontent.com')\n      .replace('/blob/', '/');\n  } else {\n    const match = url.match(/github\\.com\\/([^/]+)\\/([^/]+)/);\n    if (match) {\n      item.json.rawUrl = `https://raw.githubusercontent.com/${match[1]}/${match[2].replace('.git', '')}/main/README.md`;\n    } else {\n      item.json.rawUrl = '';\n    }\n  }\n}\nreturn $input.all();"
      },

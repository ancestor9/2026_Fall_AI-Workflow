    {
      "parameters": {
        "jsCode": "for (const item of $input.all()) {\n  let rawText = item.json.data || '';\n  let cleanCode = '';\n\n  try {\n    // ipynb JSON 파싱 후 코드/마크다운 셀 텍스트만 추출\n    const notebook = JSON.parse(rawText);\n    if (notebook.cells) {\n      cleanCode = notebook.cells\n        .map(cell => Array.isArray(cell.source) ? cell.source.join('') : cell.source)\n        .join('\\n\\n');\n    }\n  } catch (e) {\n    cleanCode = rawText;\n  }\n\n  // 안전하게 8,000자로 제한 (약 2,000 토큰 소모)\n  item.json.cleanCode = cleanCode.slice(0, 2000);\n}\nreturn $input.all();"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        -128
      ],
      "id": "2f5f8f23-ee7d-433f-900b-0149313142f2",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "jsCode": "const originalData = $('Google Sheets Read').all();\n\nreturn $input.all().map((item, index) => {\n  let grade = 0;\n  let comments = item.json.text || '';\n\n  try {\n    const cleaned = item.json.text.replace(/```json|```/g, '').trim();\n    const parsed = JSON.parse(cleaned);\n    grade = parsed.grade;\n    comments = parsed.comments;\n  } catch (e) {\n    // JSON 파싱 실패 시 예외 처리\n  }\n\n  return {\n    json: {\n      row_number: originalData[index]?.json.row_number || (index + 2),\n      name: originalData[index]?.json.name || '',\n      grade: grade,\n      comments: comments\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
